@model GameCollection
@{
    ViewData["Title"] = Model.Name;
}

<a class="back-link" asp-action="Index">← Collections</a>
<div class="section-heading page-heading">
    <div>
        <p class="eyebrow accent">Your collection · @Model.Items.Count games</p>
        <h1>@Model.Name</h1>
        <p class="muted">@Model.Description</p>
    </div>
    <a class="btn btn-subtle" asp-action="Edit" asp-route-id="@Model.Id">Edit collection</a>
</div>
<form class="filter-bar collection-picker" asp-action="AddGame" asp-route-id="@Model.Id" method="post">
    <label for="collection-game" class="visually-hidden">Search for a game to add</label>
    <select id="collection-game" name="gameKey" required data-search-url="@Url.Action("GameOptions", new { id = Model.Id })" aria-describedby="collection-search-hint">
        <option value=""></option>
    </select>
    <button type="submit" class="btn btn-accent">Add game +</button>
</form>
<p id="collection-search-hint" class="form-hint">Type at least 3 characters to search for a game.</p>
<p id="collection-search-notice" class="notice" role="status" hidden></p>
<div class="game-grid">
    @foreach (var item in Model.Items)
    {
        <div>
            <partial name="_GameCard" model="item.Game" />
            <form asp-action="RemoveGame" asp-route-id="@Model.Id" method="post" class="mt-2">
                <input type="hidden" name="gameId" value="@item.GameId" />
                <button type="submit" class="quiet-button">Remove from collection</button>
            </form>
        </div>
    }
</div>
<form class="delete-section" asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <p class="muted">Deleting this collection keeps your games and library entries.</p>
    <button class="btn btn-outline-danger" type="submit">Delete collection</button>
</form>

@section Styles {
    <link rel="stylesheet" href="~/lib/select2/select2.min.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/lib/jquery/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/select2/select2.min.js" asp-append-version="true"></script>
    <script src="~/js/collection-games.js" asp-append-version="true"></script>
}
