@model CollectionInput
@{
    var creating = Context.Request.RouteValues["action"]?.ToString() == "Create";
    ViewData["Title"] = creating ? "New collection" : "Edit collection";
}

<a class="back-link" asp-action="Index">← Collections</a>
<section class="form-panel">
    <p class="eyebrow accent">Made by you</p>
    <h1>@ViewData["Title"]</h1>
    <form method="post" asp-action="@(creating ? "Create" : "Edit")" asp-route-id="@Context.Request.RouteValues["id"]">
        <div asp-validation-summary="All" class="text-danger"></div>
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" placeholder="Games for a rainy weekend" />
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <label asp-for="CoverUrl" class="form-label">Cover image URL</label>
        <input asp-for="CoverUrl" class="form-control" placeholder="https://..." />
        <p class="form-hint">Optional. Use a direct HTTPS link to an image.</p>
        <div class="action-row">
            <button type="submit" class="btn btn-accent">Save collection</button>
            <a class="btn btn-subtle" asp-action="Index">Cancel</a>
        </div>
    </form>
    @if (!creating)
    {
        <div class="collection-cover-editor">
            <h2>Collection cover</h2>
            @if (ViewData["UploadedCoverUrl"] is string uploadedCoverUrl)
            {
                <img class="collection-cover-preview" src="@uploadedCoverUrl" alt="Current collection cover" />
                <p class="form-hint">Your uploaded image takes priority over the image link.</p>
                <form asp-route="RemoveCollectionCover" asp-route-id="@Context.Request.RouteValues["id"]" asp-route-returnToEdit="true" method="post">
                    <button class="quiet-button" type="submit">Remove uploaded cover</button>
                </form>
            }
            @if (ViewData["CanUploadCover"] is true)
            {
                <form asp-route="UploadCollectionCover" asp-route-id="@Context.Request.RouteValues["id"]" asp-route-returnToEdit="true" method="post" enctype="multipart/form-data">
                    <label for="collection-cover" class="form-label">Choose an image</label>
                    <input id="collection-cover" name="cover" type="file" class="form-control" accept="image/png,image/jpeg" required />
                    <p class="form-hint">PNG or JPEG, up to 2 MB. Uploading replaces the previous image.</p>
                    <button class="btn btn-subtle" type="submit">Upload cover</button>
                </form>
            }
            else
            {
                <p class="form-hint">Image uploads are currently unavailable. You can use an image link above.</p>
            }
        </div>
    }
</section>
