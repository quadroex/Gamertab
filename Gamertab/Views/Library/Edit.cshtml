@model LibraryEditPage
@{
    ViewData["Title"] = "Edit " + Model.Game.Name;
}

<a class="back-link" asp-action="Index">← My library</a>
<section class="form-panel">
    <p class="eyebrow accent">Your play history</p>
    <h1>@Model.Game.Name</h1>
    <a class="text-link" asp-action="Journal" asp-route-id="@Context.Request.RouteValues["id"]">Open play journal ↗</a>
    <form method="post" asp-action="Edit" asp-route-id="@Context.Request.RouteValues["id"]">
        <div asp-validation-summary="All" class="text-danger"></div>
        <input asp-for="Input.GameId" type="hidden" />
        <div class="row g-4">
            <div class="col-md-6">
                <label asp-for="Input.Status" class="form-label">Status</label>
                <select asp-for="Input.Status" asp-items="Html.GetEnumSelectList<PlayStatus>()" class="form-select"></select>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.PersonalRating" class="form-label">Your rating out of 10</label>
                <input asp-for="Input.PersonalRating" type="number" min="0" max="10" step="0.5" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="Input.StartedOn" class="form-label">Started</label>
                <input asp-for="Input.StartedOn" type="date" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="Input.CompletedOn" class="form-label">Completed</label>
                <input asp-for="Input.CompletedOn" type="date" class="form-control" />
            </div>
        </div>
        <label asp-for="Input.Notes" class="form-label mt-4">Your notes</label>
        <textarea asp-for="Input.Notes" class="form-control" rows="4" placeholder="What did you think of this game?"></textarea>
        <label class="check-label mt-4"><input asp-for="Input.FollowNews" /> Follow news and updates</label>
        <div class="action-row">
            <button class="btn btn-accent" type="submit">Save changes</button>
            <a asp-action="Index" class="btn btn-subtle">Cancel</a>
        </div>
    </form>
</section>
