@model CatalogPage
@{
    ViewData["Title"] = "Browse";
}

<section id="catalogue">
    <div class="section-heading">
        <div>
            <p class="eyebrow">@(Model.SavedOnly ? "Your saved catalogue" : "Explore games across platforms")</p>
            <h1>@(string.IsNullOrEmpty(Model.Query) ? (Model.SavedOnly ? "Saved games" : "Popular games") : "Search results")</h1>
        </div>
        <span class="muted small">@(Model.SavedOnly ? "Saved games" : Model.IsLive ? "Live discovery · IGDB" : "Live search unavailable")</span>
    </div>
    <form method="get" class="filter-bar" asp-action="Index">
        @if (Model.SavedOnly)
        {
            <input type="hidden" name="saved" value="true" />
        }
        <label class="visually-hidden" for="catalog-query">Search catalogue</label>
        <input id="catalog-query" name="q" value="@Model.Query" placeholder="Search games, e.g. Elden Ring..." class="form-control" maxlength="100" />
        <label class="visually-hidden" for="genre">Genre</label>
        <select id="genre" name="genre" class="form-select">
            <option value="">All genres</option>
            @foreach (var genre in CatalogPage.Genres.Keys)
            {
                <option value="@genre" selected="@(Model.Genre == genre)">@genre</option>
            }
        </select>
        <button type="submit" class="btn btn-subtle">Find games</button>
    </form>
    @if (Model.Notice is not null)
    {
        <p class="notice" role="status">@Model.Notice</p>
    }
    @if (Model.Games.Count == 0)
    {
        <div class="empty-state">
            @if (!Model.IsLive && !Model.SavedOnly)
            {
                <h3>Search unavailable</h3>
                <p>The live catalogue could not be reached. Your library and collections are still available.</p>
                <a asp-action="Index" asp-route-q="@Model.Query" asp-route-genre="@Model.Genre" asp-route-page="@Model.Page" class="btn btn-accent">Try again</a>
                <a asp-action="Index" asp-route-saved="true" asp-route-q="@Model.Query" class="btn btn-subtle">Search saved games</a>
            }
            else
            {
                <h3>No games found</h3>
                <p>Try another title or genre.</p>
                <a asp-action="Index" class="btn btn-accent">Clear filters</a>
            }
        </div>
    }
    <div class="game-grid">
        @foreach (var game in Model.Games)
        {
            <partial name="_GameCard" model="game" />
        }
    </div>
    @if (Model.Page > 1 || Model.HasNextPage)
    {
        <nav class="pagination-row" aria-label="Catalogue pages">
            @if (Model.Page > 1)
            {
                <a asp-route-page="@(Model.Page - 1)" asp-route-q="@Model.Query" asp-route-genre="@Model.Genre" asp-route-saved="@(Model.SavedOnly ? "true" : null)">Previous</a>
            }
            <span>Page @Model.Page</span>
            @if (Model.HasNextPage)
            {
                <a asp-route-page="@(Model.Page + 1)" asp-route-q="@Model.Query" asp-route-genre="@Model.Genre" asp-route-saved="@(Model.SavedOnly ? "true" : null)">Next</a>
            }
        </nav>
    }
</section>
