@model AccountSettingsPage
@{
    ViewData["Title"] = "Account settings";
}

<section class="form-panel">
    <p class="eyebrow accent">Your account</p>
    <h1>Account settings</h1>
    <p class="muted">@Model.Email</p>
    <h2 class="mt-4">Your plan <span class="tag">@Model.Access.Plan</span></h2>
    <p>Your library and collections are included in Standard. Library statistics is a Premium feature.</p>
    @if (Model.Access.CanViewStatistics)
    {
        <a class="btn btn-subtle" asp-controller="Library" asp-action="Statistics">View statistics</a>
    }
    @if (Model.Access.CanChangePlan)
    {
        <form class="plan-controls" asp-action="ChangePlan" method="post">
            <input type="hidden" name="plan" value="@(Model.Access.Plan == AccountPlan.Standard ? AccountPlan.Premium : AccountPlan.Standard)" />
            <button class="btn @(Model.Access.Plan == AccountPlan.Standard ? "btn-accent" : "btn-subtle")" type="submit">@(Model.Access.Plan == AccountPlan.Standard ? "Upgrade to Premium" : "Switch to Standard")</button>
            <p class="form-hint">Demo upgrade. No payment is required. You can switch back to Standard at any time.</p>
        </form>
    }
    <h2 class="mt-4">Sign-in methods</h2>
    <p>Email and password · @(Model.HasPassword ? "Enabled" : "Not set up")</p>
    @if (Model.GoogleLinked)
    {
        <p class="notice">Google is connected. You can sign in with your Google account.</p>
    }
    else
    {
        <p class="muted">Connect Google to sign in to this same library with your Google account.</p>
        <form asp-action="LinkGoogle" method="post">
            <button class="btn btn-google" type="submit" disabled="@(!Model.GoogleAvailable)">Connect Google</button>
        </form>
        @if (!Model.GoogleAvailable)
        {
            <p class="form-hint mt-2">Google sign-in is currently unavailable.</p>
        }
    }
</section>
