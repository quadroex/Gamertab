@model RegisterInput
@{
    ViewData["Title"] = "Create your account";
}

<section class="auth-panel">
    <p class="eyebrow accent">Your next chapter</p>
    <h1>Make it your library</h1>
    <p class="muted">Save games, keep your progress and discover what comes next.</p>
    <partial name="_GoogleSignIn" />
    <form method="post" asp-action="Register">
        <div asp-validation-summary="All" class="text-danger"></div>
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" autocomplete="email" />
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" autocomplete="new-password" />
        <p class="form-hint">At least 10 characters with uppercase, lowercase and a number.</p>
        <label asp-for="ConfirmPassword" class="form-label">Confirm password</label>
        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
        <button class="btn btn-accent w-100 mt-4" type="submit">Create account</button>
    </form>
    <p class="muted mt-4 mb-0">Already here? <a asp-action="Login">Sign in</a></p>
</section>
