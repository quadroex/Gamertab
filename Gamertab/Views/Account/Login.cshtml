@model LoginInput
@{
    ViewData["Title"] = "Welcome back";
}

<section class="auth-panel">
    <p class="eyebrow accent">Pick up where you left off</p>
    <h1>Welcome back.</h1>
    <form method="post" asp-action="Login">
        <div asp-validation-summary="All" class="text-danger"></div>
        <input asp-for="ReturnUrl" type="hidden" />
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" autocomplete="email" />
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" autocomplete="current-password" />
        <button class="btn btn-accent w-100 mt-4" type="submit">Sign in</button>
    </form>
    <p class="muted mt-4 mb-0">New to Gamertab? <a asp-action="Register">Create an account</a></p>
</section>
