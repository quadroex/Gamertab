            ]
          }
        }
      ]
    },
    {
      "name": "Register local test account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/account/register",
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{email}}\",\"password\":\"{{password}}\",\"confirmPassword\":\"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Registered email matches\", () => pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get(\"email\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "Refresh authenticated session",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/account/session"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Signed in\", () => pm.expect(pm.response.json().authenticated).to.eql(true));",
              "pm.collectionVariables.set(\"csrf\", pm.response.json().csrfToken);"
            ]
          }
        }
      ]
    },
