{
  "info": {
    "name": "Gamertab local API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Local API checks. The runner creates a temporary database and removes it after the run. Manual runs create a qa account in the selected environment."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5180"
    },
    {
      "key": "password",
      "value": "GamertabTest2026"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if ([\"POST\", \"PUT\", \"DELETE\"].includes(pm.request.method)) {",
          "    pm.request.headers.upsert({ key: \"X-CSRF-TOKEN\", value: pm.collectionVariables.get(\"csrf\") || \"\" });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Start session",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/account/session"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"csrf\", pm.response.json().csrfToken);",
              "pm.collectionVariables.set(\"email\", \"qa-\" + pm.variables.replaceIn(\"{{$randomUUID}}\") + \"@example.test\");",
              "pm.test(\"Anonymous session\", () => pm.expect(pm.response.json().authenticated).to.eql(false));",
              "pm.test(\"Session is not stored\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Read catalogue",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/games?skip=0&limit=2"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Pagination\", () => pm.expect(pm.response.json().items.length).to.eql(2));",
              "pm.collectionVariables.set(\"gameId\", pm.response.json().items[0].id);",
              "pm.collectionVariables.set(\"gameName\", pm.response.json().items[0].name);",
              "pm.collectionVariables.set(\"firstIds\", JSON.stringify(pm.response.json().items.map(game => game.id)));",
              "pm.collectionVariables.set(\"nextLink\", pm.response.json().nextLink);",
              "pm.test(\"Next page is available\", () => pm.expect(pm.response.json().nextLink).to.be.a(\"string\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Read catalogue again",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/games?skip=0&limit=2"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Repeated page is stable\", () => pm.expect(pm.response.json().items.map(game => game.id)).to.eql(JSON.parse(pm.collectionVariables.get(\"firstIds\"))));"
            ]
          }
        }
      ]
    },
    {
      "name": "Follow next page",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{nextLink}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Next page has distinct games\", () => { const first = JSON.parse(pm.collectionVariables.get(\"firstIds\")); pm.expect(pm.response.json().items.every(game => !first.includes(game.id))).to.eql(true); });",
              "pm.test(\"Offset advances\", () => pm.expect(pm.response.json().skip).to.eql(2));"
            ]
          }
        }
      ]
    },
    {
      "name": "Read game details",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/games/{{gameId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Game identity is preserved\", () => { const game = pm.response.json(); pm.expect(game.id).to.eql(Number(pm.collectionVariables.get(\"gameId\"))); pm.expect(game.name).to.eql(pm.collectionVariables.get(\"gameName\")); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Search catalogue",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/games?q=Portal&limit=100"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Search returns matching games\", () => { const data = pm.response.json(); pm.expect(data.items.length).to.be.above(0); pm.expect(data.items.every(game => game.name.toLowerCase().includes(\"portal\"))).to.eql(true); pm.expect(data.nextLink).to.eql(null); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Search descriptions",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/games?q=space%20dwarves"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Full-text match returned\", () => { const data = pm.response.json(); pm.expect(data.total).to.eql(1); pm.expect(data.items[0].name).to.eql(\"Deep Rock Galactic\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Search themes",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/games?q=fantasy"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Full-text match returned\", () => { const data = pm.response.json(); pm.expect(data.total).to.eql(1); pm.expect(data.items[0].name).to.eql(\"Hades\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject invalid page size",
      "request": {
        "method": "GET",
