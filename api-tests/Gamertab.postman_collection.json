{
  "info": {
    "name": "Gamertab local API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5180"
    },
    {
      "key": "password",
      "value": "GamertabTest2026"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if ([\"POST\", \"PUT\", \"DELETE\"].includes(pm.request.method)) {",
          "    pm.request.headers.upsert({ key: \"X-CSRF-TOKEN\", value: pm.collectionVariables.get(\"csrf\") || \"\" });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Start session",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/account/session"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"csrf\", pm.response.json().csrfToken);",
              "pm.collectionVariables.set(\"email\", \"qa-\" + pm.variables.replaceIn(\"{{$randomUUID}}\") + \"@example.test\");"
            ]
          }
        }
      ]
    },
    {
      "name": "Register local test account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/account/register",
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{email}}\",\"password\":\"{{password}}\",\"confirmPassword\":\"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "Refresh authenticated session",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/account/session"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Signed in\", () => pm.expect(pm.response.json().authenticated).to.eql(true));",
              "pm.collectionVariables.set(\"csrf\", pm.response.json().csrfToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Read catalogue",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/games?skip=0&limit=2"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Pagination\", () => pm.expect(pm.response.json().items.length).to.eql(2));",
              "pm.collectionVariables.set(\"gameId\", pm.response.json().items[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create library entry",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/library",
        "body": {
          "mode": "raw",
          "raw": "{\"gameId\":{{gameId}},\"status\":\"Planned\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"entryId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject duplicate entry",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/library",
        "body": {
          "mode": "raw",
          "raw": "{\"gameId\":{{gameId}},\"status\":\"Playing\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "Complete game",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/library/{{entryId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"gameId\":{{gameId}},\"status\":\"Completed\",\"personalRating\":8.5,\"startedOn\":\"2026-10-01\",\"completedOn\":\"2026-10-20\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Read saved entry",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/library/{{entryId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Completion saved\", () => pm.expect(pm.response.json().status).to.eql(\"Completed\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create collection",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/collections",
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"API verification\",\"description\":\"Temporary collection\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"collectionId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Add collection game",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/collections/{{collectionId}}/games",
        "body": {
          "mode": "raw",
          "raw": "{\"gameId\":{{gameId}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete temporary collection",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/collections/{{collectionId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete temporary library entry",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/library/{{entryId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Sign out",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/account/logout",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    }
  ]
}
